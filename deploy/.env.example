# Copy to .env on the server. Never commit .env.

ACME_EMAIL=meghvyas03@gmail.com

# Point these A records at the instance's public IP before starting Caddy,
# or certificate issuance will fail and get rate limited.
QUICKCOMMERCE_DOMAIN=shop.example.edu
LARP_DOMAIN=larp.example.edu

# Images built in CI and pushed to a registry — never built on this box.
QUICKCOMMERCE_IMAGE=ghcr.io/meghvyas3132/quickcommerce:latest
LARP_IMAGE=ghcr.io/meghvyas3132/larp:latest

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-to-something-long
POSTGRES_DATABASES=quickcommerce,larp
